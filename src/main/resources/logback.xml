<configuration debug="false">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5p | [%thread] %logger{5}:%L - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>sportsnet.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5p | [%thread] %logger{5}:%L - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="RESULTS-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>sportsnet-results.%d{yyyy-MM-dd4}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%logger{1}:%L - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.jstevenperry.sportsnet" level="INFO"/>
<!--    <logger name="com.jstevenperry.sportsnet.framework.util.NetworkUtils" level="DEBUG"/>-->
    <logger name="org.deeplearning4j.optimize.listeners" level="INFO"/>
<!--    <logger name="com.jstevenperry.sportsnet.framework.AbstractNetworkTrainer" level="DEBUG"/>-->
    <logger name="com.jstevenperry.sportsnet.framework.AbstractTournamentRunnerPlugin" level="DEBUG" additivity="false">
        <appender-ref ref="RESULTS-FILE"/>
    </logger>
    <root level="WARN">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

</configuration>